# Claude. Leave empty to run in rules mode (no AI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# SQLite by default. For production use Postgres, e.g. Supabase, Render or Neon:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./q2d.db

# The sample data is dated around 26 Oct 2026. Set to "live" to use today's date.
DEMO_TODAY=2026-10-26

# Pause between agent steps so people can watch a run (milliseconds). 0 = no pause.
AGENT_STEP_DELAY_MS=300

# Create the sample world on first start.
SEED_ON_START=true

# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
